---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<p class={`text-slate-500 font-light text-xs mt-1 ${className}`}>
  <span>Visitors: </span>
  <span id="visitor-count" class="text-white font-medium">...</span>
</p>

<script>
  const BASE_API_URL = "https://func-cloudresume-fsmbrj7k2vlvo.azurewebsites.net/api/GetVisitorCount";

  async function fetchVisitorCount() {
    const countElement = document.getElementById("visitor-count");

    // Check if user has already visited during this browser session
    const hasVisited = sessionStorage.getItem("has_visited_session");
    const url = hasVisited
      ? `${BASE_API_URL}?increment=false`
      : `${BASE_API_URL}?increment=true`;

    try {
      const response = await fetch(url);
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      const data = await response.json();
      if (countElement) {
        countElement.textContent = data.count.toString();
      }

      // Mark session as visited
      sessionStorage.setItem("has_visited_session", "true");
    } catch (error) {
      console.error("Error fetching visitor count:", error);
      if (countElement) {
        countElement.textContent = "--";
      }
    }
  }

  fetchVisitorCount();
  document.addEventListener("astro:after-swap", fetchVisitorCount);
</script>