			<span id="toast-message" class="block w-full text-center">Action completed successfully</span>
		</div>
	</div>

	<!-- GLOBAL SCRIPTS & MODAL KEYBOARD CONTROLLER -->
	<script is:inline>
		window.modalSelectedIndex = -1;

		window.getModalElements = function() {
			return {
				backdrop: document.getElementById('command-modal-backdrop'),
				input: document.getElementById('command-input'),
				modalItems: Array.from(document.querySelectorAll('.modal-item'))
			};
		};

		window.handleSearchInput = function() {
			const { input, modalItems } = window.getModalElements();
			if (!input) return;

			const query = input.value.toLowerCase().trim();

			// Toggle Caret based on input content
			if (query.length > 0) {
				input.classList.remove('caret-transparent');
				input.classList.add('caret-cyan-400');
			} else {
				input.classList.remove('caret-cyan-400');
				input.classList.add('caret-transparent');
			}

			// Filter modal items based on text typed
			modalItems.forEach(item => {
				const text = item.textContent?.toLowerCase() || "";
				if (text.includes(query)) {
					item.classList.remove('hidden');
				} else {
					item.classList.add('hidden');
				}
			});

			// Reset selection index after filtering
			window.modalSelectedIndex = -1;
			window.updateHighlight();
		};

		window.updateHighlight = function() {
			const visibleItems = window.getModalElements().modalItems.filter(item => !item.classList.contains('hidden'));
			
			window.getModalElements().modalItems.forEach((item) => {
				const badge = item.querySelector('.enter-badge');
				const index = visibleItems.indexOf(item);

				if (index === window.modalSelectedIndex && index !== -1) {
					item.classList.add('bg-slate-800', 'text-cyan-400', 'border-l-2', 'border-cyan-400');
					if (badge) badge.classList.remove('hidden');
				} else {
					item.classList.remove('bg-slate-800', 'text-cyan-400', 'border-l-2', 'border-cyan-400');
					if (badge) badge.classList.add('hidden');
				}
			});
		};

		window.toggleModal = function() {
			const { backdrop, input, modalItems } = window.getModalElements();
			if (!backdrop) return;

			const isHidden = backdrop.classList.contains('hidden');
			if (isHidden) {
				backdrop.classList.remove('hidden');
				window.modalSelectedIndex = -1;
				modalItems.forEach(item => item.classList.remove('hidden'));
				window.updateHighlight();
				if (input) {
					input.value = '';
					window.handleSearchInput();
					setTimeout(() => {
						input.focus();
					}, 50);
				}
			} else {
				backdrop.classList.add('hidden');
			}
		};

		// Root Keydown Listener for Ctrl+K, Escape, Arrows, & Enter
		window.addEventListener('keydown', (e) => {
			const isK = e.key === 'k' || e.key === 'K' || e.code === 'KeyK';
			const isCtrlOrCmd = e.ctrlKey || e.metaKey;

			if (isCtrlOrCmd && isK) {
				e.preventDefault();
				e.stopPropagation();
				window.toggleModal();
				return;
			}

			const { backdrop } = window.getModalElements();
			const visibleItems = window.getModalElements().modalItems.filter(item => !item.classList.contains('hidden'));

			if (backdrop && !backdrop.classList.contains('hidden')) {
				if (e.key === 'Escape') {
					backdrop.classList.add('hidden');
					return;
				}

				if (e.key === 'ArrowDown') {
					e.preventDefault();
					if (visibleItems.length === 0) return;
					window.modalSelectedIndex = (window.modalSelectedIndex + 1) % visibleItems.length;
					window.updateHighlight();
					return;
				}

				if (e.key === 'ArrowUp') {
					e.preventDefault();
					if (visibleItems.length === 0) return;
					if (window.modalSelectedIndex <= 0) {
						window.modalSelectedIndex = visibleItems.length - 1;
					} else {
						window.modalSelectedIndex--;
					}
					window.updateHighlight();
					return;
				}

				if (e.key === 'Enter') {
					e.preventDefault();
					if (window.modalSelectedIndex >= 0 && window.modalSelectedIndex < visibleItems.length) {
						const selectedElem = visibleItems[window.modalSelectedIndex];
						selectedElem.click();
					}
					return;
				}
			}
		}, true);
	</script>

	<!-- Interactive Scripts & Terminal -->
	<script>
		let activeTerminalTimeouts: any[] = [];

		function clearTerminalTimers() {
			activeTerminalTimeouts.forEach(t => clearTimeout(t));
			activeTerminalTimeouts = [];
		}

		function setupPageScripts() {
			const backdrop = document.getElementById('command-modal-backdrop');
			const modalItems = document.querySelectorAll<HTMLElement>('.modal-item');
			const copyEmailBtn = document.getElementById('copy-email-btn');
			const downloadCvBtn = document.getElementById('download-cv-btn');
			
			const flyinToast = document.getElementById('flyin-toast');
			const toastMessage = document.getElementById('toast-message');

			let toastTimeout: any = null;

			function showFlyinToast(msg: string) {
				if (!flyinToast || !toastMessage) return;
				
				toastMessage.textContent = msg;
				if (toastTimeout) clearTimeout(toastTimeout);

				flyinToast.classList.remove('translate-y-24', 'opacity-0');
				flyinToast.classList.add('translate-y-0', 'opacity-100');

				toastTimeout = setTimeout(() => {
					flyinToast.classList.remove('translate-y-0', 'opacity-100');
					flyinToast.classList.add('translate-y-24', 'opacity-0');
				}, 3200);
			}

			backdrop?.addEventListener('click', (e) => {
				if (e.target === backdrop) backdrop.classList.add('hidden');
			});

			copyEmailBtn?.addEventListener('click', () => {
				navigator.clipboard.writeText('contact@example.com');
				showFlyinToast("Email address copied to clipboard!");
				backdrop?.classList.add('hidden');
			});

			downloadCvBtn?.addEventListener('click', () => {
				showFlyinToast("Downloading CV document...");
				backdrop?.classList.add('hidden');
			});

			modalItems.forEach((item, idx) => {
				item.addEventListener('mouseenter', () => {
					const visibleItems = Array.from(modalItems).filter(i => !i.classList.contains('hidden'));
					const visibleIdx = visibleItems.indexOf(item);
					if (visibleIdx !== -1) {
						(window as any).modalSelectedIndex = visibleIdx;
						(window as any).updateHighlight();
					}
				});

				if (idx < 3) {
					item.addEventListener('click', () => backdrop?.classList.add('hidden'));
				}
			});

			// --- TERMINAL ENGINE ---
			const terminalScreen = document.getElementById('terminal-screen');
			const terminalContent = document.getElementById('terminal-content');

			clearTerminalTimers();

			function schedule(fn: Function, delay: number) {
				const t = setTimeout(fn, delay);
				activeTerminalTimeouts.push(t);
			}

			function scrollToBottom() {
				if (terminalScreen) {
					terminalScreen.scrollTop = terminalScreen.scrollHeight;
				}
			}

			const scenarios = [
				[
					{
						cmd: "boot --profile system",
						output: [
							"• interface ..... <span class='text-emerald-400'>ONLINE</span>",
							"• role .......... <span class='text-slate-200'>IT Technician</span>",
							"• focus ......... <span class='text-slate-200'>Automations & Infrastructure</span>",
							"• status ........ <span class='text-cyan-400'>READY</span>"
						]
					}
				],
				[
					{
						cmd: "docker compose up -d --build",
						output: [
							"<span class='text-slate-500'>[+] Building 2.1s (6/6) FINISHED</span>",
							"<span class='text-cyan-400'> => [1/4] STEP: unpack base alpine kernel</span>",
							"<span class='text-slate-400'> => [2/4] STEP: install dependencies</span>",
							"<span class='text-slate-400'> => Container jamf-connector  <span class='text-emerald-400'>Started</span></span>",
							"<span class='text-slate-400'> => Container uptime-kuma    <span class='text-emerald-400'>Running</span></span>",
							"<span class='text-emerald-400'>✔ Stack deployment complete.</span>"
						]
					}
				],
				[
					{
						cmd: "cloudflared tunnel status",
						output: [
							"• tunnel_id ..... <span class='text-slate-200'>8a12f94c-infra-prod</span>",
							"• edge_conn ..... <span class='text-emerald-400'>4 active connections</span>",
							"• health ........ <span class='text-emerald-400'>HEALTHY (11ms)</span>"
						]
					}
				],
				[
					{
						cmd: "systemctl restart nginx",
						output: [
							"<span class='text-red-400'>Job for nginx.service failed: Permission denied (port 443 binding requires root).</span>"
						]
					},
					{
						cmd: "sudo systemctl restart nginx",
						output: [
							"<span class='text-emerald-400'>[OK] Nginx daemon reloaded successfully. Port 443 bound.</span>"
						]
					}
				],
				[
					{
						cmd: "npm run build",
						output: [
							"<span class='text-red-400'>[ERROR] Missing required environment variable: DATABASE_URL</span>",
							"<span class='text-red-400'>[ERROR] Build aborted.</span>"
						]
					},
					{
						cmd: "export DATABASE_URL='postgres://local...' && npm run build",
						output: [
							"<span class='text-slate-400'>Building static pages...</span>",
							"<span class='text-emerald-400'>[SUCCESS] Build finished in 1.42s (12 static pages emitted).</span>"
						]
					}
				],
				[
					{
						cmd: "zpool status -x",
						output: [
							"<span class='text-amber-400'>WARNING: pool 'storage-pool' is DEGRADED.</span>",
							"<span class='text-red-400'>One or more devices experienced checksum errors.</span>"
						]
					},
					{
						cmd: "zpool scrub storage-pool",
						output: [
							"<span class='text-emerald-400'>[OK] Scrub started in background. Checksum verification active.</span>"
						]
					}
				]
			];

			let lastScenarioIdx = -1;

			function getRandomScenarioIndex() {
				let nextIdx;
				do {
					nextIdx = Math.floor(Math.random() * scenarios.length);
				} while (nextIdx === lastScenarioIdx && scenarios.length > 1);
				lastScenarioIdx = nextIdx;
				return nextIdx;
			}

			function runTerminal() {
				if (!terminalContent) return;
				terminalContent.innerHTML = "";

				const scenarioIdx = getRandomScenarioIndex();
				const scenarioSteps = scenarios[scenarioIdx];

				function executeStep(stepIndex: number) {
					if (stepIndex >= scenarioSteps.length) {
						schedule(renderClearPrompt, 400);
						return;
					}

					const step = scenarioSteps[stepIndex];

					const linePrompt = document.createElement('div');
					linePrompt.className = "flex items-center gap-1.5 flex-wrap pt-1";
					linePrompt.innerHTML = `<span class="text-cyan-400">ahine@infra</span>:<span class="text-slate-500">~</span>$&nbsp;<span class="cmd-text text-slate-200"></span><span class="cursor animate-pulse text-cyan-400 font-bold">█</span>`;
					terminalContent?.appendChild(linePrompt);
					scrollToBottom();

					const cmdTextEl = linePrompt.querySelector('.cmd-text') as HTMLElement;
					const cursorEl = linePrompt.querySelector('.cursor') as HTMLElement;

					schedule(() => {
						let i = 0;
						function typeCommand() {
							if (i < step.cmd.length) {
								cmdTextEl.textContent += step.cmd.charAt(i);
								i++;
								scrollToBottom();
								schedule(typeCommand, 65);
							} else {
								cursorEl.classList.add('hidden');
								schedule(() => typeOutputLines(step, 0, () => executeStep(stepIndex + 1)), 250);
							}
						}
						typeCommand();
					}, 450);
				}

				function typeOutputLines(step: any, lineIdx: number, onComplete: Function) {
					if (lineIdx >= step.output.length) {
						schedule(onComplete, 300);
						return;
					}

					const lineDiv = document.createElement('div');
					lineDiv.className = "text-slate-400 pl-2 border-l border-slate-800 text-[11px] leading-relaxed";
					terminalContent?.appendChild(lineDiv);

					const rawHTML = step.output[lineIdx];
					let charIndex = 0;

					const tempDiv = document.createElement('div');
					tempDiv.innerHTML = rawHTML;
					const plainText = tempDiv.textContent || "";

					function typeChar() {
						if (charIndex <= plainText.length) {
							lineDiv.textContent = plainText.slice(0, charIndex);
							charIndex++;
							scrollToBottom();
							schedule(typeChar, 16);
						} else {
							lineDiv.innerHTML = rawHTML;
							schedule(() => typeOutputLines(step, lineIdx + 1, onComplete), 100);
						}
					}
					typeChar();
				}

				function renderClearPrompt() {
					const clearPromptLine = document.createElement('div');
					clearPromptLine.className = "flex items-center gap-1.5 flex-wrap pt-2 border-t border-slate-800/40";
					clearPromptLine.innerHTML = `<span class="text-cyan-400">ahine@infra</span>:<span class="text-slate-500">~</span>$&nbsp;<span class="clear-cmd-text text-slate-200"></span><span class="animate-pulse text-cyan-400 font-bold">█</span>`;
					terminalContent?.appendChild(clearPromptLine);
					scrollToBottom();

					const clearCmdEl = clearPromptLine.querySelector('.clear-cmd-text') as HTMLElement;

					schedule(() => {
						const clearStr = "clear";
						let c = 0;
						function typeClear() {
							if (c < clearStr.length) {
								clearCmdEl.textContent += clearStr.charAt(c);
								c++;
								scrollToBottom();
								schedule(typeClear, 85);
							} else {
								schedule(() => {
									runTerminal();
								}, 500);
							}
						}
						typeClear();
					}, 2500);
				}

				executeStep(0);
			}

			runTerminal();
		}

		setupPageScripts();
		document.addEventListener('astro:page-load', setupPageScripts);
	</script>
</Layout>