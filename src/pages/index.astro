---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';

// Slice to only show the top 3 projects on the home page
const featuredProjects = projects.slice(0, 3);
---

<Layout title="Alfie Hine | IT Infrastructure & Systems Specialist">
	<main class="max-w-6xl mx-auto px-6 pt-4 pb-24">
		
		<!-- HERO SECTION -->
		<section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20 pt-2">
			<div class="lg:col-span-7">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/40 border border-cyan-500/30 text-cyan-400 text-xs font-mono mb-6">
					<span class="relative flex h-2 w-2">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
					</span>
					Open to Infrastructure & Support Roles
				</div>

				<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.1] mb-6">
					Practical IT Infrastructure<br>
					that's <span class="text-transparent bg-clip-text bg-linear-to-r from-cyan-400 to-blue-500">built to last</span>.
				</h1>

				<p class="text-slate-400 text-lg sm:text-xl leading-relaxed mb-8 max-w-2xl font-light">
					Managing school IT infrastructure, automated Google Workspace tasks, and homelab servers. Clear communication and reliable systems.
				</p>

				<div class="flex flex-wrap items-center gap-4 text-sm font-mono">
					<a href="/projects" class="group relative bg-[#091a2f] hover:bg-[#0c2442] text-slate-100 font-medium px-6 py-3 rounded-xl border-2 border-cyan-400 hover:border-cyan-300 transition-all duration-200 shadow-xl shadow-cyan-950/50 flex items-center gap-2.5">
						<span>View Projects</span>
						<span class="text-cyan-400 group-hover:translate-x-1 transition-transform duration-200">➔</span>
					</a>

					<a href="/about" class="group text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 bg-slate-900/50 px-6 py-3 rounded-xl transition flex items-center gap-2">
						<span>About me</span>
						<span class="inline-block transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
					</a>
				</div>
			</div>

			<!-- TERMINAL WIDGET -->
			<div class="lg:col-span-5">
				<div class="bg-slate-950/90 border border-slate-800 rounded-xl overflow-hidden shadow-2xl shadow-cyan-950/20 font-mono text-xs">
					<div class="bg-slate-900/80 px-4 py-2.5 border-b border-slate-800 flex items-center justify-between">
						<div class="flex items-center gap-2">
							<div class="w-3 h-3 rounded-full bg-red-500/80"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
							<div class="w-3 h-3 rounded-full bg-green-500/80"></div>
						</div>
						<span class="text-slate-500 text-[11px]">$ SESSION</span>
					</div>

					<div id="terminal-screen" class="p-4 space-y-2.5 leading-normal h-60 overflow-y-auto scroll-smooth">
						<div id="terminal-content" class="space-y-2"></div>
					</div>
				</div>
			</div>
		</section>

		<!-- FEATURED PROJECTS -->
		<section class="pt-16 border-t border-slate-800/80">
			<div class="flex items-center justify-between mb-12">
				<div>
					<p class="text-cyan-400 font-mono text-xs mb-1">FEATURED WORK</p>
					<h2 class="text-3xl font-bold text-white tracking-tight">Projects</h2>
				</div>
				<a href="/projects" class="hidden sm:flex text-xs font-mono text-slate-400 hover:text-cyan-400 items-center gap-1 transition">
					All projects ➔
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				{featuredProjects.map((project, index) => {
					const isFullSpan = (index + 1) % 3 === 0;

					return (
						<div class={`group bg-slate-900/40 border border-slate-800/80 hover:border-cyan-500/50 rounded-2xl p-6 transition-all duration-300 hover:shadow-xl hover:shadow-cyan-950/20 flex flex-col justify-between ${isFullSpan ? 'md:col-span-2 md:w-5/6 lg:w-3/4 mx-auto w-full' : ''}`}>
							<div>
								<div class="flex items-center justify-between mb-4">
									<span class="text-xs font-mono bg-cyan-950/60 text-cyan-400 border border-cyan-800/50 px-2.5 py-1 rounded-full">
										{project.category}
									</span>
									<span class="text-xs font-mono text-slate-500">
										{project.tag || project.metrics}
									</span>
								</div>
								<h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition mb-3">
									{project.title}
								</h3>
								<p class="text-slate-400 text-sm leading-relaxed mb-6 font-light">
									{project.shortDescription || project.description}
								</p>
							</div>
							<div class="flex flex-wrap items-center gap-2 text-[11px] font-mono text-slate-400 pt-4 border-t border-slate-800/50">
								{project.tech.map((t) => (
									<span class="bg-slate-950 px-2 py-1 rounded border border-slate-800">
										{t}
									</span>
								))}
							</div>
						</div>
					);
				})}
			</div>
		</section>

		<!-- CAPABILITIES SECTION -->
		<section class="pt-24 border-t border-slate-800/60 mt-16">
			<p class="text-cyan-400 font-mono text-xs mb-1 uppercase tracking-wider">Capabilities</p>
			<h2 class="text-3xl font-bold text-white tracking-tight mb-12">Core Technical Expertise</h2>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<div class="group bg-slate-900/30 border border-slate-800/80 hover:border-cyan-500/50 p-6 rounded-xl transition-all duration-300 hover:shadow-xl hover:shadow-cyan-950/20">
					<span class="text-cyan-400 font-mono text-sm">01.</span>
					<h3 class="text-white font-bold text-lg mt-2 mb-3 group-hover:text-cyan-400 transition">Technical Support & Operations</h3>
					<p class="text-slate-400 text-sm leading-relaxed font-light">
						Day-to-day school IT support, quick ticket triage, hardware repairs, and clear communication with non-technical staff.
					</p>
				</div>

				<div class="group bg-slate-900/30 border border-slate-800/80 hover:border-cyan-500/50 p-6 rounded-xl transition-all duration-300 hover:shadow-xl hover:shadow-cyan-950/20">
					<span class="text-cyan-400 font-mono text-sm">02.</span>
					<h3 class="text-white font-bold text-lg mt-2 mb-3 group-hover:text-cyan-400 transition">Systems & Virtualisation</h3>
					<p class="text-slate-400 text-sm leading-relaxed font-light">
						Managing Proxmox VE hypervisors, Debian/Ubuntu Linux servers, Docker/LXC containers, and custom PC builds.
					</p>
				</div>

				<div class="group bg-slate-900/30 border border-slate-800/80 hover:border-cyan-500/50 p-6 rounded-xl transition-all duration-300 hover:shadow-xl hover:shadow-cyan-950/20">
					<span class="text-cyan-400 font-mono text-sm">03.</span>
					<h3 class="text-white font-bold text-lg mt-2 mb-3 group-hover:text-cyan-400 transition">Networking & Storage Pools</h3>
					<p class="text-slate-400 text-sm leading-relaxed font-light">
						Setting up ZFS storage pools, Nginx reverse proxies, Cloudflare tunnels, and automated SSL certificates.
					</p>
				</div>
			</div>
		</section>

	</main>

	<!-- Interactive Terminal Engine Script -->
	<script>
		let activeTerminalTimeouts: any[] = [];

		function clearTerminalTimers() {
			activeTerminalTimeouts.forEach(t => clearTimeout(t));
			activeTerminalTimeouts = [];
		}

		function setupPageScripts() {
			const terminalScreen = document.getElementById('terminal-screen');
			const terminalContent = document.getElementById('terminal-content');

			clearTerminalTimers();

			function schedule(fn: Function, delay: number) {
				const t = setTimeout(fn, delay);
				activeTerminalTimeouts.push(t);
			}

			function scrollToBottom() {
				if (terminalScreen) {
					terminalScreen.scrollTop = terminalScreen.scrollHeight;
				}
			}

			const scenarios = [
				[
					{
						cmd: "boot --profile system",
						output: [
							"• interface ..... <span class='text-emerald-400'>ONLINE</span>",
							"• role .......... <span class='text-slate-200'>IT Technician</span>",
							"• focus ......... <span class='text-slate-200'>Automations & Infrastructure</span>",
							"• status ........ <span class='text-cyan-400'>READY</span>"
						]
					}
				],
				[
					{
						cmd: "docker compose up -d --build",
						output: [
							"<span class='text-slate-500'>[+] Building 2.1s (6/6) FINISHED</span>",
							"<span class='text-cyan-400'> => [1/4] STEP: unpack base alpine kernel</span>",
							"<span class='text-slate-400'> => [2/4] STEP: install dependencies</span>",
							"<span class='text-slate-400'> => Container jamf-connector  <span class='text-emerald-400'>Started</span></span>",
							"<span class='text-slate-400'> => Container uptime-kuma    <span class='text-emerald-400'>Running</span></span>",
							"<span class='text-emerald-400'>✔ Stack deployment complete.</span>"
						]
					}
				],
				[
					{
						cmd: "cloudflared tunnel status",
						output: [
							"• tunnel_id ..... <span class='text-slate-200'>8a12f94c-infra-prod</span>",
							"• edge_conn ..... <span class='text-emerald-400'>4 active connections</span>",
							"• health ........ <span class='text-emerald-400'>HEALTHY (11ms)</span>"
						]
					}
				],
				[
					{
						cmd: "systemctl restart nginx",
						output: [
							"<span class='text-red-400'>Job for nginx.service failed: Permission denied (port 443 binding requires root).</span>"
						]
					},
					{
						cmd: "sudo systemctl restart nginx",
						output: [
							"<span class='text-emerald-400'>[OK] Nginx daemon reloaded successfully. Port 443 bound.</span>"
						]
					}
				],
				[
					{
						cmd: "npm run build",
						output: [
							"<span class='text-red-400'>[ERROR] Missing required environment variable: DATABASE_URL</span>",
							"<span class='text-red-400'>[ERROR] Build aborted.</span>"
						]
					},
					{
						cmd: "export DATABASE_URL='postgres://local...' && npm run build",
						output: [
							"<span class='text-slate-400'>Building static pages...</span>",
							"<span class='text-emerald-400'>[SUCCESS] Build finished in 1.42s (12 static pages emitted).</span>"
						]
					}
				],
				[
					{
						cmd: "zpool status -x",
						output: [
							"<span class='text-amber-400'>WARNING: pool 'storage-pool' is DEGRADED.</span>",
							"<span class='text-red-400'>One or more devices experienced checksum errors.</span>"
						]
					},
					{
						cmd: "zpool scrub storage-pool",
						output: [
							"<span class='text-emerald-400'>[OK] Scrub started in background. Checksum verification active.</span>"
						]
					}
				]
			];

			let lastScenarioIdx = -1;

			function getRandomScenarioIndex() {
				let nextIdx;
				do {
					nextIdx = Math.floor(Math.random() * scenarios.length);
				} while (nextIdx === lastScenarioIdx && scenarios.length > 1);
				lastScenarioIdx = nextIdx;
				return nextIdx;
			}

			function runTerminal() {
				if (!terminalContent) return;
				terminalContent.innerHTML = "";

				(window as any).terminalRunning = true;
				const scenarioIdx = getRandomScenarioIndex();
				const scenarioSteps = scenarios[scenarioIdx];

				function executeStep(stepIndex: number) {
					if (stepIndex >= scenarioSteps.length) {
						schedule(renderClearPrompt, 400);
						return;
					}

					const step = scenarioSteps[stepIndex];

					const linePrompt = document.createElement('div');
					linePrompt.className = "flex items-center gap-1.5 flex-wrap pt-1";
					linePrompt.innerHTML = `<span class="text-cyan-400">ahine@infra</span>:<span class="text-slate-500">~</span>$&nbsp;<span class="cmd-text text-slate-200"></span><span class="cursor animate-pulse text-cyan-400 font-bold">█</span>`;
					terminalContent?.appendChild(linePrompt);
					scrollToBottom();

					const cmdTextEl = linePrompt.querySelector('.cmd-text') as HTMLElement;
					const cursorEl = linePrompt.querySelector('.cursor') as HTMLElement;

					schedule(() => {
						let i = 0;
						function typeCommand() {
							if (i < step.cmd.length) {
								cmdTextEl.textContent += step.cmd.charAt(i);
								i++;
								scrollToBottom();
								schedule(typeCommand, 65);
							} else {
								cursorEl.classList.add('hidden');
								schedule(() => typeOutputLines(step, 0, () => executeStep(stepIndex + 1)), 250);
							}
						}
						typeCommand();
					}, 450);
				}

				function typeOutputLines(step: any, lineIdx: number, onComplete: Function) {
					if (lineIdx >= step.output.length) {
						schedule(onComplete, 300);
						return;
					}

					const lineDiv = document.createElement('div');
					lineDiv.className = "text-slate-400 pl-2 border-l border-slate-800 text-[11px] leading-relaxed";
					terminalContent?.appendChild(lineDiv);

					const rawHTML = step.output[lineIdx];
					let charIndex = 0;

					const tempDiv = document.createElement('div');
					tempDiv.innerHTML = rawHTML;
					const plainText = tempDiv.textContent || "";

					function typeChar() {
						if (charIndex <= plainText.length) {
							lineDiv.textContent = plainText.slice(0, charIndex);
							charIndex++;
							scrollToBottom();
							schedule(typeChar, 16);
						} else {
							lineDiv.innerHTML = rawHTML;
							schedule(() => typeOutputLines(step, lineIdx + 1, onComplete), 100);
						}
					}
					typeChar();
				}

				function renderClearPrompt() {
					const clearPromptLine = document.createElement('div');
					clearPromptLine.className = "flex items-center gap-1.5 flex-wrap pt-2 border-t border-slate-800/40";
					clearPromptLine.innerHTML = `<span class="text-cyan-400">ahine@infra</span>:<span class="text-slate-500">~</span>$&nbsp;<span class="clear-cmd-text text-slate-200"></span><span class="animate-pulse text-cyan-400 font-bold">█</span>`;
					terminalContent?.appendChild(clearPromptLine);
					scrollToBottom();

					const clearCmdEl = clearPromptLine.querySelector('.clear-cmd-text') as HTMLElement;

					schedule(() => {
						const clearStr = "clear";
						let c = 0;
						function typeClear() {
							if (c < clearStr.length) {
								clearCmdEl.textContent += clearStr.charAt(c);
								c++;
								scrollToBottom();
								schedule(typeClear, 85);
							} else {
								schedule(() => {
									runTerminal();
								}, 500);
							}
						}
						typeClear();
					}, 2500);
				}

				executeStep(0);
			}

			runTerminal();
		}

		setupPageScripts();
		document.addEventListener('astro:page-load', setupPageScripts);
	</script>
</Layout>